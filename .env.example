# Base URL of the CineScope Go API (no trailing slash).
VITE_API_BASE_URL=http://localhost:8080

# Must match the API server's API_KEY (sent as X-API-Key header).
# Put your real key in local .env — never commit it.
VITE_API_KEY=

# Set to "true" only for offline UI demo without the Go API.
VITE_USE_MOCK_API=false
